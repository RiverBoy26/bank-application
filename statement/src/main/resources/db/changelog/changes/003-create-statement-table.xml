<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-statement-table" author="neo">
        <createTable tableName="statement">
            <column name="statement_id" type="UUID">
                <constraints primaryKey="true"
                             primaryKeyName="pk_statement"
                             nullable="false"/>
            </column>

            <column name="client_id" type="UUID"/>

            <column name="credit_id" type="UUID"/>

            <column name="status" type="VARCHAR(50)"/>

            <column name="creation_date" type="TIMESTAMP"/>

            <column name="applied_offer" type="JSONB"/>

            <column name="sign_date" type="TIMESTAMP"/>

            <column name="ses_code" type="INTEGER"/>

            <column name="status_history" type="JSONB"/>

            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="statement"
                baseColumnNames="client_id"
                referencedTableName="client"
                referencedColumnNames="client_id"
                constraintName="fk_statement_client"/>

        <addForeignKeyConstraint
                baseTableName="statement"
                baseColumnNames="credit_id"
                referencedTableName="credit"
                referencedColumnNames="credit_id"
                constraintName="fk_statement_credit"/>

        <createIndex tableName="statement" indexName="idx_statement_client_id">
            <column name="client_id"/>
        </createIndex>

        <createIndex tableName="statement" indexName="idx_statement_credit_id">
            <column name="credit_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="statement"/>
        </rollback>
    </changeSet>
</databaseChangeLog>